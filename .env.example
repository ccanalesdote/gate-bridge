# MQTT público (EMQX en Coolify)
PUBLIC_MQTT_URL=mqtts://mqtt.sigil.cl:8883
PUBLIC_MQTT_USER=gate_bridge
PUBLIC_MQTT_PASSWORD=
COMMAND_TOPIC=gate/command
STATUS_TOPIC=gate/status

# MQTT local (Zigbee2MQTT en casa)
LOCAL_MQTT_URL=mqtt://192.168.1.10:1883
LOCAL_MQTT_USER=
LOCAL_MQTT_PASSWORD=
LOCAL_GATE_TOPIC=zigbee2mqtt/rele_aqara_gate/set

# simulation = no publica al relé (Hito 2). live = pulso real (Hito 3).
GATE_MODE=simulation

# Ventana y protecciones
COMMAND_MAX_SKEW_MS=5000
COMMAND_MIN_TTL_MS=0
RATE_LIMIT_MS=2500
PROCESSED_MAX=1000
STATE_FILE=./state/processed.jsonl
